{
    "version": 2,
    "functions": {
        "api/groq-proxy.js": {            // ✅ BENAR
            "runtime": "nodejs24.x"
        }
    },
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        }
    ],
    "builds": [
        {
            "src": "index.html",
            "use": "@vercel/static"
        },
        {
            "src": "api/**",
            "use": "@vercel/node"
        }
    ]
}
